{
  "name": "4jasmine-dr-website",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website for 4Jasmine Dr — logistics and distribution, Free Zone Enclave, Tema, Ghana.",
  "scripts": {
    "predev": "node scripts/build-image-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-image-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "postbuild": "next-sitemap",
    "build:map": "node scripts/build-coverage-map.mjs",
    "build:images": "node scripts/build-image-manifest.mjs",
    "build:brand": "node scripts/build-logo-variants.mjs && node scripts/build-og-image.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lenis": "^1.1.18",
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "resend": "^4.0.1",
    "swiper": "^11.1.15",
    "tailwind-merge": "^2.5.5",
    "yet-another-react-lightbox": "^3.21.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "d3-geo": "^3.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "next-sitemap": "^4.2.3",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
