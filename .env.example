# Canonical site URL. Used for metadata, sitemap and JSON-LD. No trailing slash.
# Set SITE_URL and NEXT_PUBLIC_SITE_URL to the SAME value, and make it the host
# that actually SERVES the site — not one that redirects to it. Decide whether
# the apex or www is canonical, redirect the other one to it, and use that one
# here. See README, "Canonical URL".
SITE_URL=https://4jasminedrive.com
NEXT_PUBLIC_SITE_URL=https://4jasminedrive.com

# WhatsApp number in international format, digits only (no +, no spaces).
NEXT_PUBLIC_WHATSAPP=233537716237

# Third-party form endpoint (Web3Forms / Formspree). Used when the site is
# statically exported (STATIC_EXPORT=true) and the /api/contact route is unavailable.
NEXT_PUBLIC_FORM_ENDPOINT=
FORM_ENDPOINT=

# Google Analytics 4. Leave empty to disable analytics and the cookie notice entirely.
NEXT_PUBLIC_GA_ID=

# Email delivery for /api/contact (Vercel deployment only), via Resend.
# CONTACT_FROM_EMAIL must be on a domain verified in the Resend account.
# Both addresses are placeholders until the client confirms its mailboxes.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@4jasminedrive.com
CONTACT_FROM_EMAIL=website@4jasminedrive.com

# Set to true to build a static export for cPanel shared hosting.
STATIC_EXPORT=false
